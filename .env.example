# Copy to .env (or export) to enable authenticated mode. Never commit real values.
# Full Cookie header copied from a signed-in yaleconnect.yale.edu tab
# (DevTools > Network > any request to /api/v2/graphql > Request Headers > cookie).
YALECONNECT_COOKIE=CG.SessionID=dummy-session-value-not-real; AWSALB=dummy
# Comma-separated per-user ICS feed URLs from https://yaleconnect.yale.edu/ics_helper (they embed a token).
YALECONNECT_ICS_FEEDS=https://yaleconnect.yale.edu/ical/yale/ical_personal_DUMMYTOKEN.ics
# Contact string placed in the User-Agent.
FREEFOOD_CONTACT=operator@example.invalid
# Optional: where the SQLite DB and caches live (default ./var), scheduler on/off, Nominatim fallback on/off.
FREEFOOD_VAR_DIR=./var
FREEFOOD_SCHEDULER=1
FREEFOOD_ONLINE_GEOCODING=1
